{
  "schemaVersion": 1,
  "id": "investment-dashboard",
  "name": "Investment Partner Hub",
  "version": "1.0.0",
  "description": "Portfolio tracking, risk boundaries, and sequential multi-agent research.",
  "author": "Rundock",
  "rundock": {
    "minimumVersion": "0.11.8"
  },
  "ui": {
    "entry": "ui/index.js",
    "styles": ["ui/investment.css"]
  },
  "routes": [
    {
      "id": "portfolio",
      "path": "/investments",
      "label": "Investment Hub",
      "icon": "trending-up",
      "view": "portfolio"
    }
  ],
  "slots": [
    {
      "target": "chat-side-panel",
      "view": "risk-controls"
    }
  ],
  "agents": [
    {
      "slug": "lead-partner",
      "source": "agents/lead-partner.md",
      "reportsTo": "$orchestrator"
    },
    {
      "slug": "equity-analyst",
      "source": "agents/equity-analyst.md",
      "reportsTo": "lead-partner"
    },
    {
      "slug": "risk-manager",
      "source": "agents/risk-manager.md",
      "reportsTo": "lead-partner"
    }
  ],
  "skills": [
    {
      "slug": "investment-review",
      "source": "skills/investment-review/SKILL.md"
    }
  ],
  "resources": [
    {
      "id": "portfolio-state",
      "file": "portfolio-state.json",
      "template": "templates/portfolio-state.json",
      "maximumBytes": 1048576
    },
    {
      "id": "risk-profile",
      "file": "risk-profile.json",
      "template": "templates/risk-profile.json",
      "maximumBytes": 262144
    },
    {
      "id": "decision-journal",
      "file": "decision-journal.json",
      "template": "templates/decision-journal.json",
      "maximumBytes": 4194304
    }
  ]
}
